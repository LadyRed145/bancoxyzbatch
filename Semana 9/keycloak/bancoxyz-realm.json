{
  "realm": "bancoxyz",
  "displayName": "BancoXYZ",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "bancoxyz.web",
      "description": "Acceso OAuth2 al BFF Web de BancoXYZ",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "bancoxyz.mobile",
      "description": "Acceso OAuth2 al BFF Mobile de BancoXYZ",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "bancoxyz.atm",
      "description": "Acceso OAuth2 al BFF ATM de BancoXYZ",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "bff-web-client",
      "name": "BancoXYZ BFF Web",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OAUTH2_WEB_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "bancoxyz.web"
      ]
    },
    {
      "clientId": "bff-mobile-client",
      "name": "BancoXYZ BFF Mobile",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OAUTH2_MOBILE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "bancoxyz.mobile"
      ]
    },
    {
      "clientId": "bff-atm-client",
      "name": "BancoXYZ BFF ATM",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OAUTH2_ATM_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "bancoxyz.atm"
      ]
    }
  ]
}
