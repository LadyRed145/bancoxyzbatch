# BancoXYZ Semana 9 - plantilla para despliegue EC2 con HTTPS valido.
# Copiar como .env y reemplazar todos los CHANGE_ME antes de desplegar.

# Activa Caddy dentro del unico docker-compose.yml.
COMPOSE_PROFILES=ec2

# PostgreSQL compartido por las aplicaciones. Keycloak usa el esquema "keycloak".
POSTGRES_DB=bancoxyz
POSTGRES_USER=bancoxyz
POSTGRES_PASSWORD=CHANGE_ME
DB_URL=jdbc:postgresql://postgres:5432/bancoxyz

# DNS/TLS. El registro A de KEYCLOAK_DOMAIN debe apuntar a la IP publica de la EC2.
KEYCLOAK_DOMAIN=auth.CHANGE_ME.example
TLS_EMAIL=CHANGE_ME@example.com
KEYCLOAK_PORT=8084
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_START_COMMAND=start
KEYCLOAK_DB_SCHEMA=keycloak
KEYCLOAK_PUBLIC_URL=https://auth.CHANGE_ME.example
OAUTH2_ISSUER_URI=https://auth.CHANGE_ME.example/realms/bancoxyz
OAUTH2_TOKEN_URL=https://auth.CHANGE_ME.example/realms/bancoxyz/protocol/openid-connect/token

# Clientes OAuth2.
OAUTH2_WEB_CLIENT_SECRET=CHANGE_ME
OAUTH2_MOBILE_CLIENT_SECRET=CHANGE_ME
OAUTH2_ATM_CLIENT_SECRET=CHANGE_ME

# Certificados autofirmados de los BFF usados en la demostracion academica.
SSL_KEYSTORE_PASSWORD=changeit

# Kafka actual: tres brokers en la misma EC2, con replicacion a nivel de proceso.
# Para MSK/multi-host, usar la lista completa de bootstrap brokers y SSL.
KAFKA_MODE=local
KAFKA_BOOTSTRAP_SERVERS=kafka-1:19092,kafka-2:19092,kafka-3:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_UI_BIND=127.0.0.1
CONSUMER_ADMIN_BIND=127.0.0.1

# Recursos recomendados para una EC2 con 8 GiB de RAM.
KAFKA_MEM_LIMIT=768m
KAFKA_HEAP_OPTS=-Xms256m -Xmx384m
KAFKA_UI_MEM_LIMIT=512m
KEYCLOAK_MEM_LIMIT=1g
KEYCLOAK_JAVA_OPTS_KC_HEAP=-XX:InitialRAMPercentage=25 -XX:MaxRAMPercentage=60

# Escalado de microservicios de dominio.
CUENTAS_REPLICAS=1
CLIENTES_REPLICAS=1
PAGOS_REPLICAS=1
