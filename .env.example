# BancoXYZ - variables de entorno
# Copiar como .env y completar los valores CHANGE_ME.

# PostgreSQL
POSTGRES_DB=bancoxyz
POSTGRES_USER=bancoxyz
POSTGRES_PASSWORD=CHANGE_ME
DB_URL=jdbc:postgresql://postgres:5432/bancoxyz

# Keycloak / OAuth2
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_START_COMMAND=start-dev
KEYCLOAK_DB_SCHEMA=public
KEYCLOAK_PORT=8084
KEYCLOAK_PUBLIC_URL=http://localhost:8084
OAUTH2_ISSUER_URI=http://localhost:8084/realms/bancoxyz
OAUTH2_TOKEN_URL=http://localhost:8084/realms/bancoxyz/protocol/openid-connect/token

# OAuth2 Client Credentials
OAUTH2_WEB_CLIENT_SECRET=CHANGE_ME
OAUTH2_MOBILE_CLIENT_SECRET=CHANGE_ME
OAUTH2_ATM_CLIENT_SECRET=CHANGE_ME
# Contraseña de los certificados autofirmados incluidos para este laboratorio.
# En producción se deben reemplazar certificados y secreto.
SSL_KEYSTORE_PASSWORD=changeit

# Kafka UI / administración del consumer
# Se mantienen en loopback tanto localmente como en EC2.
# Para EC2 se recomienda acceso mediante túnel SSH, sin abrir 8090/8091 públicamente.
KAFKA_MODE=local
KAFKA_BOOTSTRAP_SERVERS=kafka-1:19092,kafka-2:19092,kafka-3:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_UI_BIND=127.0.0.1
CONSUMER_ADMIN_BIND=127.0.0.1

# Protección de recursos para el stack de 16 servicios lógicos
# Valores pensados para un host/VM de 8 GiB (local y EC2 t3.large).
KAFKA_MEM_LIMIT=768m
KAFKA_HEAP_OPTS=-Xms256m -Xmx384m
KAFKA_UI_MEM_LIMIT=512m
KEYCLOAK_MEM_LIMIT=1g
KEYCLOAK_JAVA_OPTS_KC_HEAP=-XX:InitialRAMPercentage=25 -XX:MaxRAMPercentage=60

# Escalabilidad horizontal de los tres microservicios de dominio S9.
# Mantener 1 en un equipo limitado; usar 2 o más para la evidencia de escalado.
CUENTAS_REPLICAS=1
CLIENTES_REPLICAS=1
PAGOS_REPLICAS=1
