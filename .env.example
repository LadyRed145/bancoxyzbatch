POSTGRES_DB=bancoxyz
POSTGRES_USER=bancoxyz
POSTGRES_PASSWORD=bancoxyz123
POSTGRES_PORT=5432

# Keycloak / OAuth2 (entorno académico local).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-change-me
KEYCLOAK_PUBLIC_URL=http://localhost:8084

# Secrets de los clientes OAuth2. Docker los inyecta al importar el realm;
# el JSON conserva sólo placeholders y no duplica los valores reales.
OAUTH2_WEB_CLIENT_SECRET=bancoxyz-web-oauth2-secret-S8-2026
OAUTH2_MOBILE_CLIENT_SECRET=bancoxyz-mobile-oauth2-secret-S8-2026
OAUTH2_ATM_CLIENT_SECRET=bancoxyz-atm-oauth2-secret-S8-2026

SSL_KEYSTORE_PASSWORD=changeit

# Timeout de comunicación BFF -> Bank Backend.
BACKEND_TIMEOUT=3s

# Resilience4j - valores académicos centralizados por Config Server.
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_DURATION=200ms
RATE_LIMIT_FOR_PERIOD=10
RATE_LIMIT_REFRESH_PERIOD=1s
RATE_LIMIT_TIMEOUT=0ms
